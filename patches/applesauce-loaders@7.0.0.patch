diff --git a/dist/helpers/parallel-cache.js b/dist/helpers/parallel-cache.js
new file mode 100644
index 0000000000000000000000000000000000000000..aa07b2d394073b69283a9f2863c4f84faa29ffef
--- /dev/null
+++ b/dist/helpers/parallel-cache.js
@@ -0,0 +1,25 @@
+import { catchError, defer, EMPTY, merge, ReplaySubject, takeUntil, tap } from "rxjs";
+
+/** An optional network-backed cache must not become a serial loading stage. */
+export function withParallelCache(primary, supplemental, matches) {
+    if (!supplemental) return primary;
+    return (pointers) => defer(() => {
+        const missing = new Set(pointers);
+        const done = new ReplaySubject(1);
+        return merge(
+            primary(pointers).pipe(tap({
+                next: (event) => {
+                    for (const pointer of missing) {
+                        if (matches(pointer, event)) missing.delete(pointer);
+                    }
+                },
+                complete: () => {
+                    // Do not occupy a batch slot waiting for a slow optional
+                    // cache when the normal sequence resolved every pointer.
+                    if (!missing.size) done.next();
+                },
+            })),
+            defer(() => supplemental(pointers)).pipe(catchError(() => EMPTY), takeUntil(done)),
+        );
+    });
+}
